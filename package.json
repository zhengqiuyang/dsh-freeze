{
  "name": "dsh-freeze",
  "version": "0.1.0",
  "description": "Hermetic composition lock for DeepSeek Harness: fingerprints the profile's plugin set, lockfile, and patch layer; a session that boots on a drifted composition says so loudly — the vendor-skills --frozen thesis, applied to the whole agent",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test scripts",
    "coverage": "c8 --exclude \"test/**\" --check-coverage --lines 60 --branches 68 --functions 68 node test/run-tests.mjs",
    "check": "npm run typecheck && npm run lint && npm run coverage",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node test/run-tests.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "reproducibility",
    "lockfile",
    "supply-chain",
    "hermetic"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.10.2",
    "c8": "^12.0.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/zhengqiuyang/dsh-freeze#readme",
  "bugs": { "url": "https://github.com/zhengqiuyang/dsh-freeze/issues" },
  "author": "zhengqiuyang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengqiuyang/dsh-freeze.git"
  }
}
